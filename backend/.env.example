# Copia este fichero a backend/.env. Con los valores por defecto el backend
# arranca en local sin ningún servicio externo (SQLite, sin Redis, email por consola).

# --- Django ---
# En local basta con DJANGO_DEBUG=True (usa una clave insegura de desarrollo).
# En producción DJANGO_SECRET_KEY es obligatoria y DJANGO_DEBUG debe ser False.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Origins allowed to change data with the session cookies and to open WebSockets.
# Defaults to CORS_ALLOWED_ORIGINS when unset.
# CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
# Same value as REVALIDATE_SECRET in frontend/.env.local: after publishing, the
# backend asks the frontend to drop its cached copy of the page (ADR-019).
# In production use a long random value.
REVALIDATE_SECRET=local-dev-only
# Trusted proxies in front of the app (0 in local development). Rate limits
# read the client IP from X-Forwarded-For only this many hops back.
NUM_PROXIES=0

# --- Base de datos ---
# Sin definir = SQLite en backend/db.sqlite3.
# DATABASE_URL=postgres://usuario:clave@host:5432/paxl

# --- Tiempo real ---
# Sin definir = InMemoryChannelLayer (un solo proceso).
# REDIS_URL=redis://localhost:6379/0

# --- Email ---
# Por defecto los emails se imprimen en la consola del backend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Paxl <noreply@localhost>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- Login con Google (opcional) ---
GOOGLE_CLIENT_ID=

# --- Generación con IA (ADR-023) ---
# Modo demo (por defecto): no se usa ninguna clave del servidor. Generar una página
# sirve una respuesta guardada (backend/ai_generation/demo_fixtures/) y editar un bloque
# devuelve una variante guardada. Quien envía su propia clave sí llama al proveedor.
AI_DEMO_MODE=True
# Segundos que tarda en llegar la respuesta guardada (0 = sin espera).
AI_DEMO_DELAY_SECONDS=2.5
# Solo con AI_DEMO_MODE=False y una clave de servidor: llamadas reales por día UTC en
# total y por usuario. Al pasarse (o si el proveedor agota su cuota) se sirve una respuesta guardada.
AI_LIVE_DAILY_LIMIT=30
AI_LIVE_USER_DAILY_LIMIT=2
# Claves del servidor (opcionales). Con AI_DEMO_MODE=True no se usan.
GOOGLE_AI_KEY=
ANTHROPIC_API_KEY=
# Modelos que se piden a cada proveedor.
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Stripe (opcional, solo modo test) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_MONTHLY=
STRIPE_PRO_PRICE_YEARLY=

# --- Modo invitado ("Probar sin registrarse") ---
# Cuentas temporales que se borran solas. El límite por IP para crearlas es
# GUEST_CREATION_RATE; GUEST_MAX_ACTIVE es el tope de invitados vivos a la vez.
# GUEST_LIFETIME_HOURS=24
# GUEST_MAX_ACTIVE=200
# GUEST_MAX_PAGES=5
# GUEST_CREATION_RATE=5/hour

# --- Dominios personalizados (ADR-027) ---
# Desactivados por defecto: necesitan verificar DNS y emitir SSL, y el hosting gratuito
# de la demo no lo permite. Desactivados, la API responde 404 FEATURE_DISABLED y la
# interfaz no muestra nada de dominios.
# CUSTOM_DOMAINS_ENABLED=False
# CUSTOM_DOMAINS_CNAME_TARGET=domains.tu-dominio.com
# CUSTOM_DOMAINS_A_RECORD=203.0.113.10
# Dominios propios de la app (y sus subdominios): nadie puede registrarlos como dominio personalizado
# CUSTOM_DOMAINS_RESERVED=tu-dominio.com
