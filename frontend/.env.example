# Copia este fichero a frontend/.env.local.

# API de Django. Con '/api', el navegador llama al propio frontend y Next
# reenvía las peticiones a BACKEND_URL (rewrite en next.config.ts): las
# cookies de sesión son del mismo sitio, igual que en producción.
NEXT_PUBLIC_API_URL=/api
# URL del backend para el rewrite y para el código que corre en el servidor
BACKEND_URL=http://localhost:8001

# URL del servidor WebSocket (colaboración en tiempo real)
NEXT_PUBLIC_WS_URL=ws://localhost:8001

# Mismo valor que REVALIDATE_SECRET en backend/.env: el backend lo usa para
# pedir que se descarte la copia en caché de una página al publicarla (ADR-019).
# En producción, un valor largo y aleatorio.
REVALIDATE_SECRET=local-dev-only

# URL pública del frontend, sin barra final. La usan robots.txt, el sitemap, las
# etiquetas Open Graph / Twitter y las direcciones que enseña el panel
# ("paxl.app/p/mi-pagina"), así que en producción tiene que ser el dominio real.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Login con Google (opcional). Debe coincidir con GOOGLE_CLIENT_ID del backend.
# Con el valor vacío no se muestra el botón ni se carga nada de Google. Con valor, el
# script de Google se carga solo en /login y /register (nunca en páginas publicadas).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Política de contenido (Content-Security-Policy, solo en `next build`/`next start`).
# Se construye con NEXT_PUBLIC_API_URL, BACKEND_URL (subidas de imágenes) y
# NEXT_PUBLIC_WS_URL (colaboración) de arriba: esos orígenes son los únicos, aparte de
# este sitio, a los que puede conectarse la aplicación. Si cambias de dominio de
# backend, cambia estas variables y vuelve a construir (se leen al compilar).

# --- Solo en Vercel (producción) ---
# Mismo valor que ORIGIN_SECRET en el backend. frontend/vercel.json lo añade como cabecera
# X-Paxl-Origin-Secret a cada petición que se reenvía a /api y /media, y el backend solo
# confía en la IP del visitante (X-Forwarded-For) si la cabecera llega (SEC-002, ADR-055).
# Defínelo solo en el entorno Production de Vercel. En local no hace falta.
# PAXL_ORIGIN_SECRET=

# Un deployment de previsualización de Vercel no reenvía /api ni /media al backend, para que
# no escriba en la base de producción. Solo si de verdad hay un backend de pruebas para las
# previews, ponlo a 1 (y BACKEND_URL en el entorno Preview).
# PAXL_ALLOW_PREVIEW_BACKEND=1

# Con VERCEL_ENV=production el build falla si falta BACKEND_URL, NEXT_PUBLIC_API_URL,
# NEXT_PUBLIC_SITE_URL o NEXT_PUBLIC_WS_URL, o si apuntan a localhost.
